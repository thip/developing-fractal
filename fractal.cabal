cabal-version:       >=1.10
name:                fractal
version:             0.1.0.0
synopsis:            Generate a surface showing an L-system fractal developing
license:             MIT
license-file:        LICENSE
author:              David Capper
maintainer:          david@thecappers.co.uk
category:            Math
build-type:          Simple

library
  hs-source-dirs:      src
  exposed-modules:     Curve
                       Layers
                       LSystem
                       Obj
                       Vector
  build-depends:       base >=4.8 , array
  default-language:    Haskell2010
  ghc-options:         -Wall

executable fractal
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       base >=4.8 , fractal , optparse-applicative
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite spec
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  build-depends:       base >=4.8 , fractal , hspec , QuickCheck
  default-language:    Haskell2010
  ghc-options:         -Wall
